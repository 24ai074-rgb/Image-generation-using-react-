# Gemini API Configuration
# 
# ✅ PAID TIER (Recommended for Production)
# ======================================
# Using paid Google Cloud project with higher quotas
# - No daily limits
# - Higher request rates (100+ requests/minute)
# - Better performance and reliability

GEMINI_API_KEY="your_paid_api_key_here"

# GEMINI_MODEL: Model to use for image generation
# Paid tier supports advanced models:
# - gemini-2.5-flash-image (recommended - latest and fastest)
# - gemini-2.0-flash (good balance of quality and speed)
# - gemini-1.5-flash (lighter weight, faster)
GEMINI_MODEL=gemini-2.5-flash-image

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000/"
